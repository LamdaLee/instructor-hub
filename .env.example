# 비밀값은 실제 .env에만 기록하고 저장소에 커밋하지 않습니다.
# Supabase 풀러라면 사용자 이름에 .POOLER_TENANT_ID를 붙입니다.
DATABASE_URL=postgres://hub_app:CHANGE_ME@DB_TAILSCALE_IP:5432/postgres
DATABASE_ADMIN_URL=postgres://postgres:CHANGE_ME@DB_TAILSCALE_IP:5432/postgres
# 서버가 TLS를 지원하면 true. 인증서 검증은 끄지 않습니다.
DATABASE_SSL=false
SESSION_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
APP_ORIGIN=https://hub.example.com
# npm run admin -- set-app-password 전용. 앱 DB 비밀번호와 일치시킵니다.
APP_DB_PASSWORD=
# 백업 없이 최초 관리자를 만들 때만 사용합니다. 생성 후 지웁니다.
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=
# 기존 Caddy가 연결된 외부 Docker 네트워크 이름
CADDY_NETWORK=caddy

# 컨테이너에서는 /app/materials 영구 볼륨. 로컬 실행 시 쓰기 가능한 절대경로 지정
MATERIALS_DIR=/app/materials
